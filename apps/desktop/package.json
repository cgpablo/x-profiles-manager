{
  "name": "x-profiles-manager",
  "version": "1.3.0",
  "description": "Local profile manager for multiple X (Twitter) accounts",
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": "Developer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-preload.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xpm/core": "*",
    "adm-zip": "^0.5.17",
    "electron-is-dev": "^2.0.0",
    "electron-squirrel-startup": "1.0.1",
    "koffi": "^3.0.2",
    "uuid": "^9.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.3.1",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.18.1",
    "electron": "33.4.11",
    "electron-builder": "^24.2.1"
  },
  "build": {
    "appId": "com.xprofilesmanager.app",
    "productName": "X Profiles Manager",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "publish": null,
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "portable"
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

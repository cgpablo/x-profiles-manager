{
  "name": "x-profiles-manager",
  "version": "0.1.0",
  "description": "Local profile manager for multiple X (Twitter) accounts",
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": "Developer",
  "license": "MIT",
  "scripts": {
    "dev": "bash dev.sh",
    "electron": "electron .",
    "react-dev": "vite --port 3000",
    "electron-dev": "wait-on --timeout 60000 --interval 500 http://localhost:3000 && electron .",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "tsc --project tsconfig.electron.json && cp src/main/webview-preload.js dist/main/webview-preload.js",
    "type-check": "tsc --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "electron-is-dev": "^2.0.0",
    "electron-squirrel-startup": "1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.3.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.2",
    "@vitejs/plugin-react": "^3.1.0",
    "concurrently": "^7.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.2.1",
    "typescript": "^4.9.5",
    "vite": "^3.2.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.xprofilesmanager.app",
    "productName": "X Profiles Manager",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "publish": null,
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "portable"
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "fsevents@2.3.3": true,
    "electron@28.3.3": true
  }
}
